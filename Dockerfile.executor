FROM python:3.12.8-slim@sha256:2199a62885a12290dc9c5be3ca0681d367576ab7bf037da120e564723292a2f0
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN pip install --no-cache-dir pandas==2.2.3 numpy==1.26.4 scipy==1.15.1 plotly==5.24.1 pyarrow==18.1.0
WORKDIR /worker
COPY src/agents/executor_worker.py /worker/executor_worker.py
COPY src/agents/toolkit.py /worker/src/agents/toolkit.py
RUN mkdir -p /worker/src/agents && touch /worker/src/__init__.py /worker/src/agents/__init__.py
USER 65534:65534
ENTRYPOINT ["python", "/worker/executor_worker.py"]
